# Directory for Agent 6's own data: the SQLite file, repository clones and uploaded images.
DATA_DIR=./data

# Key for encrypting stored secrets (connection passwords). 32 bytes as base64.
# Generate one with: openssl rand -base64 32
# Keep it safe: secrets saved with one key cannot be read with another.
ENCRYPTION_KEY=

# Secret for signing login sessions. At least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Address people open Agent 6 at, without a trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# The first Admin. Created when the server starts and no user exists yet.
# Once any user exists these two are ignored, even if you change them.
# The password needs at least 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# GitHub token Agent 6 uses to clone Repositories and to file issues.
# For every repository you connect it needs read access to Contents, and read
# and write access to Issues (classic token: the `repo` scope). Its user needs
# write access to the repository, or GitHub drops the labels on filed issues.
# Without the token Agent 6 starts, but no Repository can be connected or synced.
# Without the Issues permission the agent still answers; reporting to the team
# fails and Admins see that in the Conversation.
GITHUB_TOKEN=

# Model used to answer Conversations. Chat stays unavailable until both are set.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional cheaper model for the input Guardrail; defaults to OPENAI_MODEL.
# Uses the same API key and endpoint.
GUARDRAIL_MODEL=
# Optional OpenAI-compatible endpoint, including its API prefix (for example /v1).
# Agent 6 uses Chat Completions, including for compatible servers.
OPENAI_BASE_URL=
