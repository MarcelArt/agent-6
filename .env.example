# Required for local runs: own SQLite file, repository clones and uploaded images.
# Docker Compose overrides this to /data in its persistent named volume.
DATA_DIR=./data

# Required. Key for stored connection passwords, auth headers and OAuth secrets.
# 32 bytes as base64.
# Generate one with: openssl rand -base64 32
# Keep it safe: secrets saved with one key cannot be read with another.
ENCRYPTION_KEY=

# Required. Secret for signing login sessions. At least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Required. Public address people open Agent 6 at, without a trailing slash.
# Use your HTTPS origin behind a reverse proxy, e.g. https://support.example.com.
BETTER_AUTH_URL=http://localhost:3000

# Required only on first startup. Created when no user exists yet.
# Once any user exists these two are ignored, even if you change them.
# Example email: admin@example.com. Use your own address.
# The password needs at least 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional at startup. GitHub token used to clone Repositories and file issues.
# For every repository you connect it needs read access to Contents, and read
# and write access to Issues (classic token: the `repo` scope). Its user needs
# write access to the repository, or GitHub drops the labels on filed issues.
# Without the token Agent 6 starts, but no Repository can be connected or synced.
# Without the Issues permission the agent still answers; reporting to the team
# fails and Admins see that in the Conversation.
GITHUB_TOKEN=

# Optional at startup. Model used for replies; chat needs both values.
# Example model name: the tool-capable model ID supplied by your provider.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional cheaper model for the input Guardrail; defaults to OPENAI_MODEL.
# Uses the same API key and endpoint.
GUARDRAIL_MODEL=
# Optional OpenAI-compatible endpoint, including its API prefix (for example /v1).
# Agent 6 uses Chat Completions, including for compatible servers.
OPENAI_BASE_URL=

# Optional Compose host binding. Default: loopback, for a proxy on this server.
# For a direct LAN test set BIND_ADDRESS to the server's LAN address.
BIND_ADDRESS=127.0.0.1
# Optional published host port. The container always listens on port 3000.
PORT=3000

# Docker sets NODE_ENV=production, HOST=0.0.0.0 and SERVER_SHUTDOWN_TIMEOUT=110
# (seconds) in the container. Compose fixes these runtime values; no edit needed.
# OAuth is configured in Admin Settings and stored encrypted in the data volume;
# there are no OAuth environment variables.
