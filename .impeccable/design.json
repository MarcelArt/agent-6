  "narrative": {
    "northStar": "The Support Desk",
    "overview": "The Support Desk keeps the current task and its context close together. Its quiet, compact and precise character comes from a shared navigation rail, a persistent record list and an adjacent working pane. Familiar controls make the interface easy to scan; restrained violet actions, neutral surfaces and modest type changes carry the hierarchy.\n\nThe system uses the existing shadcn base-mira components, Base UI behavior and Lucide icons. Administration stays dense, while Client messages, choices and the composer receive more reading room. Light and dark themes express the same hierarchy. This document records the implemented system and preserves the approved three-pane direction.",
    "keyCharacteristics": [
      "Quiet, compact and precise, with familiar task controls.",
      "A shared three-pane shell that becomes one pane with bottom navigation on phones.",
      "One violet action accent over zinc neutral surfaces.",
      "Geist throughout, with larger Client conversation text.",
      "Explicit status, visible keyboard focus and recoverable error states."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Use the existing semantic theme roles; do not introduce local color literals or a second accent palette.",
        "section": "colors"
      },
      {
        "name": "The Contrast Pair Rule",
        "body": "Primary is a fill, not running text. Keep selected-row secondary text at foreground with 70% opacity; use destructive outline actions instead of destructive tinted buttons for confirmations.",
        "section": "colors"
      },
      {
        "name": "The Reading Scale Rule",
        "body": "Preserve the browser-relative root size and the larger Client text. Do not shrink text to recover space in dense panes.",
        "section": "typography"
      },
      {
        "name": "The Pane Continuity Rule",
        "body": "Keep selection, search and pagination in the URL, and let each visible pane scroll independently.",
        "section": "layout"
      },
      {
        "name": "The Floating Surface Rule",
        "body": "Keep work surfaces flat. Retain the component preset shadows on floating menus and selects, without adding decorative shadows to panes or cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the existing UI primitives and shared record list/detail components.",
      "Do preserve both themes, semantic tokens and browser-relative sizing.",
      "Do give icon controls accessible names, keyboard focus and explanatory tooltips where established.",
      "Do pair status icons with words and preserve error, loading, disabled and empty states.",
      "Do verify desktop and 375px phone layouts in both themes when changing UI.",
      "Do keep Client-facing progress and recovery copy plain and actionable."
    ],
    "donts": [
      "Don't change the frozen color, font or radius tokens as part of a screen extension.",
      "Don't introduce gradients, ornamental shadows or a separate administration identity.",
      "Don't use primary-colored running text in dark theme or destructive text on a destructive tint in light theme.",
      "Don't use muted text on a selected neutral row; use the established foreground-opacity treatment.",
      "Don't use the smallest preset buttons or keyboard-key component, or rely on the Badge primitive's smaller default text.",
      "Don't place destructive record actions next to Save; keep them in the record menu and confirmation flow.",
      "Don't treat the older screenshots' pixel dimensions as current measurements."
    ]
  }
}
