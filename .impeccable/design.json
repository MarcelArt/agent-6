      "description": "Standalone field with responsive text, placeholder, focus, invalid and disabled states.",
      "html": "<input class=\"ds-input\" aria-label=\"Application name\" placeholder=\"Application name\">",
      "css": ".ds-input{width:100%;min-width:0;height:1.75rem;border:1px solid var(--input);border-radius:calc(var(--radius) * .8);background:color-mix(in oklab,var(--input) 20%,transparent);padding:.125rem .5rem;color:var(--foreground);font-family:var(--font-sans,'Geist Variable',sans-serif);font-size:.875rem;line-height:1.428571;outline:none;transition:color 150ms cubic-bezier(.4,0,.2,1),background-color 150ms cubic-bezier(.4,0,.2,1),border-color 150ms cubic-bezier(.4,0,.2,1),box-shadow 150ms cubic-bezier(.4,0,.2,1)}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{border-color:var(--ring);box-shadow:0 0 0 2px color-mix(in oklab,var(--ring) 30%,transparent)}.ds-input:disabled{opacity:.5;cursor:not-allowed;pointer-events:none}.ds-input[aria-invalid=true]{border-color:var(--destructive);box-shadow:0 0 0 2px color-mix(in oklab,var(--destructive) 20%,transparent)}:host-context(.dark) .ds-input{background:color-mix(in oklab,var(--input) 30%,transparent)}:host-context(.dark) .ds-input[aria-invalid=true]{border-color:color-mix(in oklab,var(--destructive) 50%,transparent);box-shadow:0 0 0 2px color-mix(in oklab,var(--destructive) 40%,transparent)}@media(min-width:48rem){.ds-input{font-size:.75rem;line-height:1.625}}"
    },
