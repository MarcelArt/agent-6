      "name": "Button / primary",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary action.",
      "html": "<button type=\"button\" class=\"ds-btn-primary\">Save changes</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:.25rem;height:1.75rem;padding:0 .5rem;border:1px solid transparent;border-radius:calc(var(--radius) * .8);background:transparent;color:var(--foreground);font-family:var(--font-sans,'Geist Variable',sans-serif);font-size:.75rem;font-weight:500;line-height:1.625;white-space:nowrap;cursor:pointer;outline:none;transition:all 150ms cubic-bezier(.4,0,.2,1);background:var(--primary);color:var(--primary-foreground);}.ds-btn-primary:hover{background:color-mix(in oklab,var(--primary) 80%,transparent);}.ds-btn-primary:focus-visible{border-color:var(--ring);box-shadow:0 0 0 2px color-mix(in oklab,var(--ring) 30%,transparent)}.ds-btn-primary:active:not([aria-haspopup]){transform:translateY(1px)}.ds-btn-primary:disabled{opacity:.5;pointer-events:none}"
    },
    {
