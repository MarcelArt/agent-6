      "html": "<button type=\"button\" class=\"ds-btn-outline\">Cancel</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;gap:.25rem;height:1.75rem;padding:0 .5rem;border:1px solid transparent;border-radius:calc(var(--radius) * .8);background:transparent;color:var(--foreground);font-family:var(--font-sans,'Geist Variable',sans-serif);font-size:.75rem;font-weight:500;line-height:1.625;white-space:nowrap;cursor:pointer;outline:none;transition:all 150ms cubic-bezier(.4,0,.2,1);border-color:var(--border);}.ds-btn-outline:hover{background:color-mix(in oklab,var(--input) 50%,transparent);color:var(--foreground);}.ds-btn-outline:focus-visible{border-color:var(--ring);box-shadow:0 0 0 2px color-mix(in oklab,var(--ring) 30%,transparent)}.ds-btn-outline:active:not([aria-haspopup]){transform:translateY(1px)}.ds-btn-outline:disabled{opacity:.5;pointer-events:none}:host-context(.dark) .ds-btn-outline{background:color-mix(in oklab,var(--input) 30%,transparent)}"
